# WhatsApp bridge (whatsmeow) configuration

# Where the bridge listens for the Node app (HTTP + WebSocket). Keep it on localhost.
BRIDGE_ADDR=127.0.0.1:8088

# Shared secret required on every API call + the WS (?token= or Authorization: Bearer).
# Leave empty ONLY on a trusted localhost bind. Set a long random value in production.
BRIDGE_TOKEN=

# SQLite file where whatsmeow stores the WhatsApp session (device keys). Survives restarts.
BRIDGE_STORE_DSN=file:/root/whatsapp-mailbox-node/bridge/whatsmeow-store.db?_foreign_keys=on&_journal_mode=WAL

# Where downloaded media is written — point this at the Node app's uploads/media dir so
# the existing Express static handler serves it. The bridge writes files; Node stores the URL.
BRIDGE_MEDIA_DIR=/root/whatsapp-mailbox-node/uploads/media

# URL prefix the Node app serves BRIDGE_MEDIA_DIR under (used to build mediaUrl in events).
BRIDGE_MEDIA_URL_PREFIX=/uploads/media/
